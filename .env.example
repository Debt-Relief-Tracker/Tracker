# Copy to .env and fill in for your deployment. None of these are required
# for a local, no-auth, SQLite-backed instance -- see docs/architecture/ for
# the reasoning behind each one.

# --- Web server ---
# Required by docker-compose.yml -- generate with `mix phx.gen.secret`.
SECRET_KEY_BASE=
# PORT=4123
# PHX_HOST=example.com
# PHX_SERVER=true is set automatically by bin/server (used in the Docker
# image/docker-compose.yml) -- only set it yourself if running the release
# binary directly, e.g. `bin/debt_relief_tracker start`.
# PHX_SERVER=true

# --- Database (docs/architecture/0001-dual-database-adapter.md) ---
# Default: SQLite, using DATABASE_PATH (defaults to /data/debt_tracker.db in
# the Docker image). Set DATABASE_URL to use Postgres instead (see
# docker-compose.postgres.yml).
# DATABASE_PATH=/data/debt_tracker.db
# DATABASE_URL=ecto://user:pass@host/debt_relief_tracker
# POOL_SIZE=10

# Only used by docker-compose.postgres.yml.
# POSTGRES_PASSWORD=

# --- Optional OIDC auth & sharing (docs/architecture/0002-auth-and-sharing-model.md) ---
# Leave all three unset for the default no-login mode (one shared workspace,
# no accounts). Set all three to require login via an external OIDC
# provider -- each user then gets their own workspace, shareable with other
# logged-in users from within the app.
# OIDC_ISSUER=https://your-provider.example.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# The callback URL to register with your provider is: <your-host>/auth/callback

# Admin access (README's "Admin access" section) -- the ID-token claim the
# app reads a role list from to grant /admin. Only takes effect once OIDC is
# configured above. Defaults to https://debt-relief-tracker.app/roles.
# OIDC_ROLES_CLAIM=

# --- Email (Resend) -- required in production (config/runtime.exs) ---
# Not needed in dev/test -- mail is captured locally (Local adapter) / by the
# Test adapter. In production the app fails to boot without these two set.
# RESEND_API_KEY=
# MAILER_FROM_EMAIL=
# MAILER_FROM_NAME=Debt Relief Tracker

# --- Field encryption (docs/architecture/0005-field-level-encryption.md) ---
# Required in production. 32 random bytes, base64-encoded -- generate with:
#   elixir -e ':crypto.strong_rand_bytes(32) |> Base.encode64() |> IO.puts()'
# Encrypts debt/payment/retirement amounts and labels at rest so a raw
# database dump is unreadable. LOSING THIS KEY PERMANENTLY DESTROYS THE DATA.
# Dev/test use a fixed dummy key from config/dev.exs & config/test.exs.
# ENCRYPTION_KEY=
